{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "ignorePaths": ["py/sublime_bridge/.python-version"],
  "packageRules": [
    {
      "matchPackageNames": [
        "k8s.io/api",
        "k8s.io/client-go",
        "k8s.io/metrics",
        "k8s.io/apimachinery"
      ],
      "allowedVersions": "<= v0.30.14",
      "description": "pinned: downstream cluster compatibility constraint"
    },
    {
      "matchPackageNames": ["github.com/google/gnostic-models"],
      "allowedVersions": "<= v0.6.9"
    },
    {
      "matchPackageNames": ["github.com/mark3labs/mcp-go"],
      "allowedVersions": "< v1.0.0",
      "description": "pinned: 1.0 implements protocol 2026-07-28 which removed protocol-level sessions (SEP-2567); goclauded session binding needs transport-independent identity first"
    },
    {
      "matchPackageNames": ["github.com/gdamore/tcell/v2"],
      "allowedVersions": "<= v2.13.7"
    },
    {
      "matchDatasources": ["go"],
      "matchPackageNames": ["github.com/kestra-io/client-sdk/go-sdk"],
      "matchUpdateTypes": ["digest"],
      "automerge": true
    },
    {
      "matchDatasources": ["go"],
      "matchPackageNames": ["github.com/grafana/loki-client-go"],
      "enabled": false,
      "description": "broken upstream: new digest references removed parser.ParseMetric"
    }
  ]
}

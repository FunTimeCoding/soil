FROM python:3.15-slim
RUN apt-get update && \
    apt-get install --yes --no-install-recommends libatomic1 && \
    rm -rf /var/lib/apt/lists/* && \
    pip install --no-cache-dir playwright xlrd xlutils xlwt xlsxwriter jsons requests && \
    playwright install --with-deps chromium
COPY tmp/goraidparsed/linux-amd64/goraidparsed /usr/local/bin
COPY strata/container/raidparse/parser/ /opt/parser/
COPY strata/container/raidparse/tiddler_import.py /opt/parser
COPY strata/container/raidparse/TW5_Top_Stat_Parse.html /opt/template
ENTRYPOINT ["goraidparsed"]
